# Production Environment Variables Template

# ================================
# BACKEND (Railway/Render/Heroku)
# ================================

# Database (Fourni automatiquement par Railway/Supabase)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Application
NODE_ENV=production
PORT=3001
API_URL=https://votre-api.railway.app
WEB_URL=https://votre-app.vercel.app

# JWT - GÉNÉREZ DES SECRETS ALÉATOIRES LONGS (min 64 caractères)
# Utilisez: openssl rand -base64 64
JWT_SECRET=CHANGEZ_CETTE_VALEUR_PAR_UN_SECRET_ALEATOIRE_LONG_ET_SECURISE
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=UN_AUTRE_SECRET_DIFFERENT_POUR_LE_REFRESH_TOKEN
JWT_REFRESH_EXPIRES_IN=30d

# Redis (Optionnel - pour caching)
REDIS_URL=redis://default:password@host:6379

# CORS - URL de votre frontend
CORS_ORIGIN=https://votre-app.vercel.app

# Rate Limiting (Plus strict en production)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging (info ou warn en production)
LOG_LEVEL=info

# ================================
# FRONTEND (Vercel)
# ================================

# API URLs - Pointent vers votre backend Railway/Render
NEXT_PUBLIC_API_URL=https://votre-api.railway.app/api
NEXT_PUBLIC_WS_URL=https://votre-api.railway.app

# Analytics (Optionnel)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
